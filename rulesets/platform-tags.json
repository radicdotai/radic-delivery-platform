{
  "name": "platform-tags",
  "target": "tag",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["refs/tags/v1.*.*"], "exclude": [] } },
  "bypass_actors": [
    { "actor_type": "Team", "actor_id": 0, "bypass_mode": "always" }
  ],
  "rules": [
    { "type": "update" },
    { "type": "deletion" },
    { "type": "non_fast_forward" }
  ]
}
