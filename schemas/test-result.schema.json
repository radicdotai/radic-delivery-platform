{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/radicdotai/delivery-platform/schemas/test-result.schema.json",
  "title": "Test Result Record",
  "description": "Shape of releases/<id>/test-results/<environment>-<repo>-<suite>.json. Stable contract for a later feature; not read or written by the engine scaffold.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "repo", "environment", "release_id", "digest", "commit",
    "suite", "runner", "started_at", "finished_at", "result", "counts",
    "skip_budget", "run_url", "cloud_deploy"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "repo": { "type": "string", "pattern": "^radicdotai/[A-Za-z0-9_.-]+$" },
    "environment": { "type": "string", "enum": ["dev", "stage"] },
    "release_id": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]+(-hf)?$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "suite": { "type": "string", "minLength": 1 },
    "runner": { "type": "string", "enum": ["pytest", "playwright"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "result": { "type": "string", "enum": ["pass", "fail", "error", "timeout"] },
    "counts": {
      "type": "object",
      "required": ["total", "passed", "failed", "skipped", "quarantined"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "quarantined": { "type": "integer", "minimum": 0 }
      }
    },
    "skip_budget": {
      "type": "object",
      "required": ["allowed", "exceptions"],
      "properties": {
        "allowed": { "const": 0 },
        "exceptions": { "type": "array", "items": { "type": "string", "pattern": "^EXC-[0-9]{4}$" } }
      }
    },
    "run_url": { "type": "string", "format": "uri" },
    "cloud_deploy": {
      "type": "object",
      "properties": {
        "pipeline": { "type": "string" },
        "target": { "type": "string" },
        "release": { "type": "string" },
        "rollout": { "type": "string" },
        "rollout_state": { "const": "SUCCEEDED" },
        "verify": { "type": "boolean" }
      }
    }
  },
  "if": {
    "properties": { "environment": { "const": "stage" } }
  },
  "then": {
    "properties": {
      "scope": { "const": "full" }
    },
    "required": ["scope"]
  }
}
