{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/radicdotai/delivery-platform/schemas/service.schema.json",
  "title": "Service Descriptor",
  "description": "The .radic/service.yml contract every service repo on radic-delivery-platform must satisfy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "service", "repo", "runtime", "build", "environments", "cloud_deploy", "quality", "release"],
  "properties": {
    "schema_version": { "const": 1 },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "owner"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,40}$" },
        "kind": { "type": "string", "enum": ["api", "bff", "web", "worker", "console"] },
        "owner": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "enum": ["stable", "canary"], "default": "stable" }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "trunk"],
      "properties": {
        "slug": { "type": "string", "pattern": "^radicdotai/[A-Za-z0-9_.-]+$" },
        "trunk": { "const": "dev" },
        "prod_line": { "const": "main", "default": "main" },
        "release_branch_prefix": { "const": "release/", "default": "release/" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "version"],
      "properties": {
        "template": { "type": "string", "enum": ["python-uv", "node"] },
        "version": { "type": "string", "minLength": 1 },
        "framework": { "type": "string" },
        "package_manager": { "type": "string", "enum": ["uv", "npm"] },
        "system_packages": {
          "type": "array",
          "items": { "type": "string", "enum": ["ffmpeg", "libcairo2"] },
          "uniqueItems": true
        },
        "services": {
          "type": "array",
          "items": { "type": "string", "enum": ["redis", "postgres", "postgrest", "firebase-auth-emulator"] },
          "uniqueItems": true
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dockerfile", "image"],
      "properties": {
        "dockerfile": { "type": "string", "default": "Dockerfile" },
        "context": { "type": "string", "default": "." },
        "target": { "type": "string" },
        "env_agnostic": { "type": "boolean", "default": false },
        "dockerignore_required": { "type": "boolean", "default": true },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry", "repository", "name"],
          "properties": {
            "registry": { "type": "string", "pattern": "^[a-z0-9-]+-docker\\.pkg\\.dev$" },
            "repository": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "human_tags": {
              "type": "array",
              "items": { "type": "string", "enum": ["dev-latest", "stage-latest", "prod-latest"] },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev", "stage", "prod"],
      "properties": {
        "dev": { "$ref": "#/$defs/environment" },
        "stage": { "$ref": "#/$defs/environment" },
        "prod": { "$ref": "#/$defs/environment" }
      }
    },
    "deployables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "terraform_module"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["service", "worker", "job", "scheduler", "pubsub"] },
          "terraform_module": { "type": "string", "minLength": 1 },
          "cloud_run_name": { "type": "string" },
          "only_in": {
            "type": "array",
            "items": { "type": "string", "enum": ["dev", "stage", "prod"] },
            "uniqueItems": true
          },
          "health_checked": { "type": "boolean", "default": false }
        }
      }
    },
    "cloud_deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "skaffold_file", "planes", "deployables"],
      "properties": {
        "driver": { "const": "cloud-deploy" },
        "skaffold_file": { "type": "string", "default": "deploy/skaffold.yaml" },
        "planes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dev", "release"],
          "properties": {
            "dev": { "const": "radicai" },
            "release": { "const": "radicai-production" }
          }
        },
        "deployables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "pipelines"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["service", "job", "workerpool"] },
              "enabled": { "type": "boolean", "default": true },
              "only_in": {
                "type": "array",
                "items": { "type": "string", "enum": ["dev", "stage", "prod"] },
                "uniqueItems": true
              },
              "pipelines": {
                "type": "object",
                "additionalProperties": false,
                "required": ["dev"],
                "properties": {
                  "dev": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,60}-dev$" },
                  "rel": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,60}-rel$" }
                }
              },
              "service_yaml": { "$ref": "#/$defs/envFiles" },
              "job_yaml": { "$ref": "#/$defs/envFiles" },
              "health": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": { "type": "string" },
                  "mode": { "type": "string", "enum": ["http", "gcloud-ready"], "default": "http" },
                  "verify": { "type": "boolean" }
                }
              },
              "require_approval": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "prod": { "const": true, "default": true }
                }
              },
              "parity": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "allow": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
                }
              },
              "migration": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "runs_in": { "const": "github", "default": "github" },
                  "hooks_experiment": { "type": "boolean", "default": false }
                }
              },
              "notes": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "terraform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir_pattern", "apply_mode"],
      "properties": {
        "dir_pattern": { "type": "string", "minLength": 1 },
        "apply_mode": { "type": "string", "enum": ["targeted", "full"] },
        "targets": { "type": "array", "items": { "type": "string" } },
        "ci_applies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "tool": { "type": "string", "enum": ["alembic", "django-manage", "alembic+manage"] },
        "job_name": { "type": "string" },
        "service_accounts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dev": { "type": "string", "pattern": "^[a-z0-9-]+@[a-z0-9-]+\\.iam\\.gserviceaccount\\.com$|^TODO-VERIFY$" },
            "stage": { "type": "string", "pattern": "^[a-z0-9-]+@[a-z0-9-]+\\.iam\\.gserviceaccount\\.com$|^TODO-VERIFY$" },
            "prod": { "type": "string", "pattern": "^[a-z0-9-]+@[a-z0-9-]+\\.iam\\.gserviceaccount\\.com$|^TODO-VERIFY$" }
          }
        },
        "cloud_sql_proxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string" },
            "checksum_verified": { "type": "boolean" },
            "ports": { "type": "array", "items": { "type": "integer" } }
          }
        },
        "checks": {
          "type": "array",
          "items": { "type": "string", "enum": ["alembic_check", "migration_graph", "migrations_frozen", "schema_check"] }
        },
        "hooks": {
          "type": "array",
          "items": { "type": "string", "enum": ["warehouse_provision", "federation_bootstrap", "dataform_sync"] }
        },
        "frozen_check_workflow_files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lint", "typecheck", "unit", "coverage_floor", "skip_budget", "post_deploy"],
      "properties": {
        "lint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool"],
          "properties": {
            "tool": { "type": "string", "enum": ["ruff", "eslint"] }
          }
        },
        "typecheck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "blocking"],
          "properties": {
            "tool": { "type": "string", "enum": ["mypy", "tsc"] },
            "blocking": { "const": true }
          }
        },
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runner"],
          "properties": {
            "runner": { "type": "string", "enum": ["pytest", "vitest"] },
            "marker_expr": { "type": "string", "pattern": "^[a-z_ ()]+$" },
            "script": { "type": "string", "pattern": "^[a-z0-9:_-]+$" },
            "db_tests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "path": { "type": "string" },
                "run_after_unit_success_only": { "const": true, "default": true }
              }
            }
          }
        },
        "coverage_floor": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["global"],
              "properties": {
                "global": { "type": "number", "minimum": 0, "maximum": 100 },
                "per_file_check": { "type": "string" },
                "ratchet": { "type": "boolean", "default": true }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["statements", "branches", "functions", "lines"],
              "properties": {
                "statements": { "type": "number", "minimum": 0, "maximum": 100 },
                "branches": { "type": "number", "minimum": 0, "maximum": 100 },
                "functions": { "type": "number", "minimum": 0, "maximum": 100 },
                "lines": { "type": "number", "minimum": 0, "maximum": 100 },
                "per_file_check": { "type": "string" },
                "ratchet": { "type": "boolean", "default": true }
              }
            }
          ]
        },
        "mutation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "min_score": { "type": "number", "minimum": 0, "maximum": 100 },
            "script": { "type": "string" }
          }
        },
        "skip_budget": { "type": "integer", "minimum": 0, "maximum": 0 },
        "quarantine": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_days": { "const": 7, "default": 7 },
            "max_percent_of_tests": { "const": 2, "default": 2 }
          }
        },
        "post_deploy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["suites"],
          "properties": {
            "exception_id": { "type": "string", "pattern": "^EXC-[0-9]{4}$" },
            "suites": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "runner", "target", "environments"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "runner": { "type": "string", "enum": ["pytest", "playwright"] },
                  "target": { "type": "string", "pattern": "^[A-Za-z0-9:_ .@|()/!-]+$" },
                  "environments": {
                    "type": "array",
                    "items": { "type": "string", "enum": ["dev", "stage"] },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "tags_included": {
                    "type": "array",
                    "items": { "type": "string", "enum": ["@seeded", "@writes", "@smoke"] }
                  },
                  "tags_excluded": {
                    "type": "array",
                    "items": { "type": "string", "enum": ["@seeded", "@writes", "@smoke"] }
                  },
                  "needs_auth_emulator": { "type": "boolean" },
                  "timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 60 }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "suites": { "type": "array", "maxItems": 0 } },
                "required": ["suites"]
              },
              "then": { "required": ["exception_id"] }
            }
          ]
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag_scheme", "promotion"],
      "properties": {
        "tag_scheme": { "const": "semver" },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verify"],
          "properties": {
            "verify": { "const": "ancestry+tree+tag" }
          }
        },
        "jira_project": { "type": "string", "pattern": "^[A-Z]{2,10}$" },
        "notes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "change_note_bucket": { "type": "string" },
            "slack_preview": { "type": "boolean" }
          }
        }
      }
    },
    "secrets_inventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github": { "type": "array", "items": { "type": "string" } },
        "secret_manager_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dev": { "oneOf": [{ "type": "integer" }, { "const": "TODO-VERIFY" }] },
            "stage": { "oneOf": [{ "type": "integer" }, { "const": "TODO-VERIFY" }] },
            "prod": { "oneOf": [{ "type": "integer" }, { "const": "TODO-VERIFY" }] }
          }
        }
      }
    }
  },
  "$defs": {
    "envFiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dev": { "type": "string", "pattern": "^deploy/[A-Za-z0-9/_.-]+\\.yaml$" },
        "stage": { "type": "string", "pattern": "^deploy/[A-Za-z0-9/_.-]+\\.yaml$" },
        "prod": { "type": "string", "pattern": "^deploy/[A-Za-z0-9/_.-]+\\.yaml$" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp_project", "region", "cloud_run_service", "health", "state"],
      "properties": {
        "gcp_project": { "type": "string", "minLength": 1 },
        "region": { "const": "us-central1" },
        "cloud_run_service": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "timeout_seconds", "fail_on_timeout"],
          "properties": {
            "url": { "type": "string" },
            "mode": { "type": "string", "enum": ["http", "gcloud-ready"], "default": "http" },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 900 },
            "fail_on_timeout": { "const": true }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bucket", "prefix"],
          "properties": {
            "bucket": { "type": "string", "minLength": 1 },
            "prefix": { "type": "string", "minLength": 1 }
          }
        },
        "deployer_service_account": { "type": "string" },
        "datasets": { "type": "array", "items": { "type": "string" } },
        "buckets": { "type": "array", "items": { "type": "string" } },
        "pubsub_topics": { "type": "array", "items": { "type": "string" } },
        "github_environment": { "type": "string", "enum": ["dev", "stage", "prod"] }
      }
    }
  }
}
